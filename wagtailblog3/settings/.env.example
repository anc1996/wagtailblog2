# Copy this file to .env.test for a test environment. Never commit either copy.
# This file contains test-safe example names and must not be used as production
# configuration. Production requires a separately managed .env.production with
# verified production values, loaded by systemd before startup.

WAGTAILBLOG_ENV=test
DJANGO_SECRET_KEY=replace-with-a-long-random-value

# Shared infrastructure
SERVICE_HOST=192.168.20.2

# MySQL
MYSQL_NAME=wagtailsoftblog_test
MYSQL_USER=root
MYSQL_PASSWORD=replace-me
MYSQL_HOST=192.168.20.2
MYSQL_PORT=3306

# Redis: database 1 is the application cache, 2 is comment rate limiting,
# 3 is Celery results, and 2 is Celery's broker queue in the current design.
REDIS_HOST=192.168.20.2
REDIS_PORT=6379
REDIS_PASSWORD=replace-me
REDIS_DB=1
REDIS_CACHE_DB=1
REDIS_COMMENT_CACHE_DB=2

# MongoDB content store
MONGO_NAME=wagtailblog_test
MONGO_HOST=192.168.20.2
MONGO_PORT=27017
MONGO_DEBUG=false

# MinIO / S3-compatible media storage
MINIO_BUCKET=wagtail-test-bucket
MINIO_ENDPOINT=http://192.168.20.2:9000
MINIO_ACCESS_KEY=replace-me
MINIO_SECRET_KEY=replace-me
MINIO_QUERYSTRING_AUTH=false
MINIO_FILE_OVERWRITE=false
MINIO_DEFAULT_ACL=public-read
MINIO_VERIFY=false

# Wagtail content search
ELASTICSEARCH_URL=http://192.168.20.2:9200
ELASTICSEARCH_INDEX_PREFIX=wagtailblog-test
ELASTICSEARCH_TIMEOUT=10

# 独立内容搜索同步骨架（默认关闭，生产启用前需要单独授权）
CONTENT_SEARCH_PRODUCER_ENABLED=false
CONTENT_SEARCH_CONSUMER_ENABLED=false
CONTENT_SEARCH_SHADOW_READ_ENABLED=false
CONTENT_SEARCH_QUERY_ENABLED=false
CONTENT_SEARCH_CURSOR_ENABLED=false
CONTENT_SEARCH_CURSOR_MAX_AGE_SECONDS=900
CONTENT_SEARCH_PIT_ENABLED=false
CONTENT_SEARCH_PIT_KEEP_ALIVE=1m
SEARCH_SUGGESTIONS_V2_ENABLED=false
SEARCH_POPULAR_SUGGESTIONS_ENABLED=false
SEARCH_TITLE_SUGGESTIONS_ENABLED=false
CONTENT_SEARCH_TITLE_SUGGESTIONS_READ_ALIAS=wagtailblog-test-content-title-read
CONTENT_SEARCH_RECONCILE_ENABLED=false
CONTENT_SEARCH_DELIVERY_BATCH_SIZE=100
CONTENT_SEARCH_LEASE_SECONDS=120
CONTENT_SEARCH_MAX_ATTEMPTS=10
CONTENT_SEARCH_RETRY_BASE_SECONDS=5
CONTENT_SEARCH_RETRY_MAX_SECONDS=3600
CONTENT_SEARCH_INDEX_PREFIX=wagtailblog-test-content
CONTENT_SEARCH_CONNECTION_NAME=default
CONTENT_SEARCH_PRODUCTION_CONNECTION_NAME=
CONTENT_SEARCH_PRODUCTION_INDEX_PREFIX=
CONTENT_SEARCH_PRODUCTION_BACKUP_ROOT=
CONTENT_SEARCH_PRODUCTION_INDEX_CREATE_ENABLED=false
# WP6 独立 ES 集群默认关闭；启用前必须具备 HTTPS、CA 校验、最小权限账号和 snapshot。
CONTENT_SEARCH_SECONDARY_CONNECTION_ENABLED=false
CONTENT_SEARCH_SECONDARY_CONNECTION_NAME=content_secondary
CONTENT_SEARCH_SECONDARY_URL=
CONTENT_SEARCH_SECONDARY_INDEX_PREFIX=wagtailblog-secondary
CONTENT_SEARCH_SECONDARY_VERIFY_CERTS=true
CONTENT_SEARCH_SECONDARY_CA_CERTS=
CONTENT_SEARCH_SECONDARY_AUTH_MODE=
CONTENT_SEARCH_SECONDARY_API_KEY=
CONTENT_SEARCH_SECONDARY_USERNAME=
CONTENT_SEARCH_SECONDARY_PASSWORD=
CONTENT_SEARCH_SECONDARY_TIMEOUT=10
CONTENT_SEARCH_READ_ALIAS=wagtailblog-test-content-read
CONTENT_SEARCH_SHADOW_TARGET_ID=
CONTENT_SEARCH_SHADOW_SAMPLE_RATE=0
CONTENT_SEARCH_SHADOW_TIMEOUT_SECONDS=0.25
CONTENT_SEARCH_SHADOW_MAX_WORKERS=1
CONTENT_SEARCH_SHADOW_MAX_IN_FLIGHT=2
CONTENT_SEARCH_SHADOW_FAILURE_THRESHOLD=3
CONTENT_SEARCH_SHADOW_COOLDOWN_SECONDS=30
# 独立内容索引原型；生产参数必须在容量和快照确认后另行设置。
CONTENT_SEARCH_INDEX_SHARDS=1
CONTENT_SEARCH_INDEX_REPLICAS=0
CONTENT_SEARCH_INDEX_REFRESH_INTERVAL=30s
CONTENT_SEARCH_REBUILD_BATCH_SIZE=200
CONTENT_SEARCH_REBUILD_MAX_BATCH_BYTES=4194304

# 生产内容搜索复用现有单节点 ES 时使用独立逻辑连接和索引前缀；默认关闭。
CONTENT_SEARCH_PRODUCTION_CONNECTION_NAME=
CONTENT_SEARCH_PRODUCTION_INDEX_PREFIX=
CONTENT_SEARCH_PRODUCTION_BACKUP_ROOT=
CONTENT_SEARCH_PRODUCTION_INDEX_CREATE_ENABLED=false
CONTENT_SEARCH_PRODUCTION_EXISTING_CLUSTER_ENABLED=false
CONTENT_SEARCH_PRODUCTION_EXISTING_CLUSTER_URL=
CONTENT_SEARCH_PRODUCTION_EXISTING_CLUSTER_VERIFY_CERTS=true
CONTENT_SEARCH_PRODUCTION_EXISTING_CLUSTER_AUTH_MODE=none
CONTENT_SEARCH_PRODUCTION_EXISTING_CLUSTER_API_KEY=
CONTENT_SEARCH_PRODUCTION_EXISTING_CLUSTER_USERNAME=
CONTENT_SEARCH_PRODUCTION_EXISTING_CLUSTER_PASSWORD=
CONTENT_SEARCH_PRODUCTION_CONNECTION_TIMEOUT=10

# Elasticsearch log pipeline (also consumed by Filebeat)
ELASTICSEARCH_LOG_ENABLED=false
ELASTICSEARCH_LOG_URL=http://192.168.20.2:9200
ELASTICSEARCH_LOG_READ_INDEX=wagtailblog-test-logs-read
ELASTICSEARCH_LOG_WRITE_INDEX=wagtailblog-test-logs-write
ELASTICSEARCH_LOG_INGEST_PIPELINE=wagtailblog-test-logs-normalize-v2
ELASTICSEARCH_LOG_TIMEZONE=Asia/Shanghai
ELASTICSEARCH_LOG_TIMEOUT=2
ELASTICSEARCH_LOG_VERIFY_CERTS=true
ELASTICSEARCH_LOG_FAILURE_COOLDOWN=5
ELASTICSEARCH_LOG_CA_CERTS=
ELASTICSEARCH_LOG_AUTH_MODE=
ELASTICSEARCH_LOG_API_KEY=
ELASTICSEARCH_LOG_USERNAME=
ELASTICSEARCH_LOG_PASSWORD=
ELASTICSEARCH_LOG_SHARDS=1
ELASTICSEARCH_LOG_REPLICAS=0
ELASTICSEARCH_LOG_ILM_POLICY=

# SMTP
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=465
EMAIL_USE_SSL=true
EMAIL_USE_TLS=false
EMAIL_HOST_USER=replace-me@example.com
EMAIL_HOST_PASSWORD=replace-me
DEFAULT_FROM_EMAIL=replace-me@example.com
EMAIL_TIMEOUT=30
EMAIL_MAX_RECIPIENTS=50
